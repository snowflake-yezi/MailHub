{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mailhub.example/schemas/filter-contract/v1/contract.schema.json",
  "title": "MailHub filter contract v1",
  "oneOf": [
    { "$ref": "#/$defs/manualBundle" },
    { "$ref": "#/$defs/adBundle" },
    { "$ref": "#/$defs/filterDecision" },
    { "$ref": "#/$defs/outboxEvent" },
    { "$ref": "#/$defs/releaseReceipt" }
  ],
  "$defs": {
    "schemaVersion": { "const": 1 },
    "checksum": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "score": { "type": "number", "multipleOf": 0.001 },
    "mode": { "enum": ["shadow", "enforce", "disabled"] },
    "action": { "enum": ["allow", "tag", "quarantine"] },
    "condition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["field", "operator", "value", "negated", "position"],
      "properties": {
        "field": { "type": "string", "minLength": 1 },
        "operator": { "type": "string", "minLength": 1 },
        "value": { "type": ["string", "boolean", "integer", "null"] },
        "negated": { "type": "boolean" },
        "position": { "type": "integer", "minimum": 0 }
      }
    },
    "manualRule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["logical_id", "name", "scope_type", "scope_id", "action", "priority", "mode", "source", "conditions"],
      "properties": {
        "logical_id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "scope_type": { "const": "global" },
        "scope_id": { "type": "null" },
        "action": { "$ref": "#/$defs/action" },
        "priority": { "type": "integer" },
        "mode": { "$ref": "#/$defs/mode" },
        "source": { "enum": ["manual", "legacy_migration", "external"] },
        "conditions": { "type": "array", "minItems": 1, "maxItems": 20, "items": { "$ref": "#/$defs/condition" } }
      }
    },
    "manualBundle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "policy_kind", "revision", "checksum", "rules"],
      "properties": {
        "schema_version": { "$ref": "#/$defs/schemaVersion" },
        "policy_kind": { "const": "manual" },
        "revision": { "type": "integer", "minimum": 1 },
        "checksum": { "$ref": "#/$defs/checksum" },
        "rules": { "type": "array", "maxItems": 500, "items": { "$ref": "#/$defs/manualRule" } }
      }
    },
    "detector": {
      "type": "object",
      "additionalProperties": false,
      "required": ["logical_id", "name", "symbol", "mode", "source", "source_reference", "conditions"],
      "properties": {
        "logical_id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "symbol": { "type": "string", "pattern": "^AD_[A-Z0-9_]{2,60}$" },
        "mode": { "$ref": "#/$defs/mode" },
        "source": { "enum": ["local", "rspamd_seed", "stalwart_seed", "spamassassin_seed", "external"] },
        "source_reference": { "type": "string" },
        "conditions": { "type": "array", "minItems": 1, "maxItems": 20, "items": { "$ref": "#/$defs/condition" } }
      }
    },
    "composite": {
      "type": "object",
      "additionalProperties": false,
      "required": ["logical_id", "name", "symbol", "mode", "score_policy", "all_of", "any_of", "none_of"],
      "properties": {
        "logical_id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "symbol": { "type": "string", "pattern": "^AD_[A-Z0-9_]{2,60}$" },
        "mode": { "$ref": "#/$defs/mode" },
        "score_policy": { "enum": ["keep_inputs", "suppress_direct_inputs"] },
        "all_of": { "$ref": "#/$defs/symbolList" },
        "any_of": { "$ref": "#/$defs/symbolList" },
        "none_of": { "$ref": "#/$defs/symbolList" }
      }
    },
    "symbolList": {
      "type": "array",
      "maxItems": 20,
      "items": { "type": "string", "pattern": "^AD_[A-Z0-9_]{2,60}$" },
      "uniqueItems": true
    },
    "weight": {
      "type": "object",
      "additionalProperties": false,
      "required": ["symbol", "score"],
      "properties": {
        "symbol": { "type": "string", "pattern": "^AD_[A-Z0-9_]{2,60}$" },
        "score": { "allOf": [{ "$ref": "#/$defs/score" }, { "minimum": -100, "maximum": 100 }] }
      }
    },
    "adBundle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "policy_kind", "revision", "checksum", "tag_threshold", "quarantine_threshold", "detectors", "composites", "weights"],
      "properties": {
        "schema_version": { "$ref": "#/$defs/schemaVersion" },
        "policy_kind": { "const": "ad" },
        "revision": { "type": "integer", "minimum": 1 },
        "checksum": { "$ref": "#/$defs/checksum" },
        "tag_threshold": { "allOf": [{ "$ref": "#/$defs/score" }, { "exclusiveMinimum": 0 }] },
        "quarantine_threshold": { "allOf": [{ "$ref": "#/$defs/score" }, { "maximum": 10000 }] },
        "detectors": { "type": "array", "maxItems": 500, "items": { "$ref": "#/$defs/detector" } },
        "composites": { "type": "array", "maxItems": 200, "items": { "$ref": "#/$defs/composite" } },
        "weights": { "type": "array", "items": { "$ref": "#/$defs/weight" } }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["field", "summary", "occurrences"],
      "properties": {
        "field": { "type": "string" },
        "summary": { "type": "string" },
        "occurrences": { "type": "integer", "minimum": 0 }
      }
    },
    "symbolResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["producer_logical_id", "symbol", "matched", "weight", "suppressed_by", "contribution", "occurrence_count", "evidence"],
      "properties": {
        "producer_logical_id": { "type": "string" },
        "symbol": { "type": "string" },
        "matched": { "type": "boolean" },
        "weight": { "$ref": "#/$defs/score" },
        "suppressed_by": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "contribution": { "$ref": "#/$defs/score" },
        "occurrence_count": { "type": "integer", "minimum": 0 },
        "evidence": { "type": "array", "items": { "$ref": "#/$defs/evidence" } }
      }
    },
    "decisionReason": {
      "type": "object",
      "additionalProperties": false,
      "required": ["logical_id", "name", "action", "matched_fields", "evidence"],
      "properties": {
        "logical_id": { "type": "string" },
        "name": { "type": "string" },
        "action": { "$ref": "#/$defs/action" },
        "matched_fields": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "evidence": { "type": "array", "items": { "$ref": "#/$defs/evidence" } }
      }
    },
    "shadowResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["policy_kind", "producer_logical_id", "symbol", "action", "score", "symbols", "evidence"],
      "properties": {
        "policy_kind": { "enum": ["manual", "ad"] },
        "producer_logical_id": { "type": "string" },
        "symbol": { "type": "string" },
        "action": { "$ref": "#/$defs/action" },
        "score": { "$ref": "#/$defs/score" },
        "symbols": { "type": "array", "items": { "$ref": "#/$defs/symbolResult" } },
        "evidence": { "type": "array", "items": { "$ref": "#/$defs/evidence" } }
      }
    },
    "filterDecision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "decision_key", "message_key", "manual_revision", "ad_revision", "manual_action", "ad_action", "final_action", "ad_score", "reasons", "ad_symbols", "shadow_results", "parse_warnings", "evaluated_at"],
      "properties": {
        "schema_version": { "$ref": "#/$defs/schemaVersion" },
        "decision_key": { "type": "string", "minLength": 1 },
        "message_key": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "manual_revision": { "type": "integer", "minimum": 0 },
        "ad_revision": { "type": "integer", "minimum": 0 },
        "manual_action": { "$ref": "#/$defs/action" },
        "ad_action": { "$ref": "#/$defs/action" },
        "final_action": { "$ref": "#/$defs/action" },
        "ad_score": { "$ref": "#/$defs/score" },
        "reasons": { "type": "array", "items": { "$ref": "#/$defs/decisionReason" } },
        "ad_symbols": { "type": "array", "items": { "$ref": "#/$defs/symbolResult" } },
        "shadow_results": { "type": "array", "items": { "$ref": "#/$defs/shadowResult" } },
        "parse_warnings": { "type": "array", "items": { "type": "string" } },
        "evaluated_at": { "type": "string", "format": "date-time" }
      }
    },
    "processingResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "attempted_action", "actual_action", "quarantine_key", "error_code", "error_summary"],
      "properties": {
        "status": { "enum": ["succeeded", "failed"] },
        "attempted_action": { "$ref": "#/$defs/action" },
        "actual_action": { "$ref": "#/$defs/action" },
        "quarantine_key": { "type": "string" },
        "error_code": { "type": "string" },
        "error_summary": { "type": "string" }
      }
    },
    "outboxEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "phase", "node_id", "mailbox", "message_id", "decision", "result"],
      "properties": {
        "schema_version": { "$ref": "#/$defs/schemaVersion" },
        "phase": { "enum": ["staged", "ready"] },
        "node_id": { "type": "integer", "minimum": 1 },
        "mailbox": { "type": "string", "minLength": 1 },
        "message_id": { "type": "string" },
        "decision": { "$ref": "#/$defs/filterDecision" },
        "result": { "oneOf": [{ "$ref": "#/$defs/processingResult" }, { "type": "null" }] }
      }
    },
    "releaseReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "operation_id", "quarantine_key", "decision_key", "status", "smtp_delivered", "restored_to_cur", "forward_target", "error_code", "error_summary", "completed_at"],
      "properties": {
        "schema_version": { "$ref": "#/$defs/schemaVersion" },
        "operation_id": { "type": "string", "minLength": 1 },
        "quarantine_key": { "type": "string", "minLength": 1 },
        "decision_key": { "type": "string", "minLength": 1 },
        "status": { "enum": ["in_progress", "completed", "failed"] },
        "smtp_delivered": { "type": "boolean" },
        "restored_to_cur": { "type": "boolean" },
        "forward_target": { "type": "string" },
        "error_code": { "type": "string" },
        "error_summary": { "type": "string" },
        "completed_at": { "type": "string", "format": "date-time" }
      }
    }
  }
}
